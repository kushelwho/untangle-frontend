# Optional: Specify the backend API base URL for production builds
# If left unset, client requests default to '/api', which works with:
# 1. Vite proxy in local development (http://localhost:5173/api -> http://localhost:8080/api)
# 2. Nginx reverse proxy in Docker Compose (http://localhost/api -> http://api:8080/api)
VITE_API_BASE_URL=http://localhost:8080/api
